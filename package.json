{
  "name": "ipa-shuttle",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.10.0 <12"
  },
  "knip": {
    "ignoreBinaries": ["gofmt"]
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "i18n:check": "node scripts/i18n-audit.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm i18n:check && pnpm typecheck && vite build",
    "build:engine": "bash scripts/build-engine.sh",
    "build:dmg": "bash scripts/build-dmg.sh",
    "tauri:build": "cargo tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "knip": "6.25.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
