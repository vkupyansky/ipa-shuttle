{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IPA Shuttle",
  "version": "0.1.0",
  "identifier": "app.ipashuttle.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build:engine && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IPA Shuttle",
        "width": 1180,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/IPA Shuttle/Icons/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "shortDescription": "Move iOS apps through Apple-provided IPA downloads",
    "longDescription": "IPA Shuttle downloads IPA files through the user's Apple ID and installs them on a connected iPhone without jailbreak, DRM bypass, patching, cracking, or re-signing.",
    "resources": [
      "resources/bin/apple-auth-engine",
      "resources/bin/ipashuttle-icons",
      "resources/bin/idevice_id",
      "resources/bin/ideviceinfo",
      "resources/bin/ideviceinstaller",
      "resources/lib/libcrypto.3.dylib",
      "resources/lib/libimobiledevice-1.0.6.dylib",
      "resources/lib/libimobiledevice-glue-1.0.0.dylib",
      "resources/lib/liblzma.5.dylib",
      "resources/lib/libplist-2.0.4.dylib",
      "resources/lib/libssl.3.dylib",
      "resources/lib/libusbmuxd-2.0.7.dylib",
      "resources/lib/libzip.5.dylib",
      "resources/lib/libzstd.1.dylib"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "./dmg/background@2x.png",
        "windowPosition": {
          "x": 200,
          "y": 120
        },
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 170,
          "y": 215
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 215
        }
      }
    }
  }
}
